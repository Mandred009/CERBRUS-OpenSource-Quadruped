        <joint name="back_right_b_joint" pos="0 0.02 0.055" axis="1 0 0" range="-1.57 1.57"/>
        <geom type="mesh" mesh="back_right_b_link" contype="0" conaffinity="0" rgba="0.79216 0.81961 0.93333 1"/>
        
        <body name="back_right_ul_link" pos="0 0.005 0">
          <inertial pos="0 0 -0.065" mass="0.15" diaginertia="0.0003 0.0003 0.0001"/>
          <joint name="back_right_ul_joint" axis="0 1 0" range="-1.57 1.57"/>
