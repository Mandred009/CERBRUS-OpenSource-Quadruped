          <body name="front_left_ll_link" pos="0 0.004658 -0.13">
            <inertial pos="0 0 -0.09" mass="0.1" diaginertia="0.0002 0.0002 0.00005"/>
            <joint name="front_left_ll_joint" axis="0 1 0" range="-2.7 -0.5"/>
            <geom type="mesh" mesh="front_left_ll_link" contype="0" conaffinity="0" rgba="0.79216 0.81961 0.93333 1"/>
            <geom name="fl_calf_col" type="capsule" fromto="0 -0.02 0 0 -0.02 -0.15" size="0.01" rgba="0 1 0 0"/>
            <geom name="fl_foot" type="sphere" pos="0 -0.02 -0.17" size="0.02" rgba="0 0 1 0.5" friction="1 0.5 0.5"/>
