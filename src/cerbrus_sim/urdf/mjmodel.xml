      <geom name="base_collision" type="box" size="0.15 0.1 0.05" rgba="1 0 0 0"/>

      <!-- Front Left Leg -->
      <body name="front_left_b_link" pos="0.23983 0.15958 -0.063453">
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
        <joint name="front_left_b_joint" pos="0 -0.02 0.055" axis="1 0 0" range="-1.57 1.57"/>
        <geom type="mesh" mesh="front_left_b_link" contype="0" conaffinity="0" rgba="0.79216 0.81961 0.93333 1"/>
        
        <body name="front_left_ul_link" pos="0 -0.005 0">
