<mujoco model="cerbrus_urdf">
  <compiler angle="radian" meshdir="meshes/"/>

  <option timestep="0.001" iterations="100" solver="Newton" gravity="0 0 -9.81">
    <flag warmstart="enable"/>
  </option>

  <default>
    <joint damping="2" armature="0.01" frictionloss="0.2"/>
    <geom friction="0.6 0.5 0.5" condim="3" contype="1" conaffinity="1"/>
    <position kp="100" forcerange="-33.5 33.5"/>
  </default>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="front_left_b_link" file="front_left_b_link.STL"/>
    <mesh name="front_left_ul_link" file="front_left_ul_link.STL"/>
