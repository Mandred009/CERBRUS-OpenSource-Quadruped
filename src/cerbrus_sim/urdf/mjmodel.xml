    <position name="RR_hip" joint="back_left_b_joint" kp="100" ctrlrange="-1.57 1.57"/>
    <position name="RR_thigh" joint="back_left_ul_joint" kp="100" ctrlrange="-1.57 1.57"/>
    <position name="RR_calf" joint="back_left_ll_joint" kp="100" ctrlrange="-2.7 -0.5"/>
