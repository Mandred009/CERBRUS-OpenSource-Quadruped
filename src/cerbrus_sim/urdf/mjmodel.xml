            <geom name="fr_foot" type="sphere" pos="0 0.02 -0.17" size="0.02" rgba="0 0 1 0.5" friction="1 0.5 0.5"/>
          </body>
        </body>
      </body>

      <!-- Back Left Leg -->
      <body name="back_left_b_link" pos="-0.24033 0.156 -0.064768">
