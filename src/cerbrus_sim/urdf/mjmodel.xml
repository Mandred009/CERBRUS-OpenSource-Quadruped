  </worldbody>

  <actuator>
    <position name="FR_hip" joint="front_left_b_joint" kp="100" ctrlrange="-1.57 1.57"/>
    <position name="FR_thigh" joint="front_left_ul_joint" kp="100" ctrlrange="-1.57 1.57"/>
    <position name="FR_calf" joint="front_left_ll_joint" kp="100" ctrlrange="-2.7 -0.5"/>
